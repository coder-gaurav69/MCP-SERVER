# ─── Server ────────────────────────────────────────────
HOST=0.0.0.0
PORT=1000

# ─── Storage & Data (Generic AI Outputs) ──────────────────────
# All AI-generated files (screenshots, scripts, tests, scratchpad, etc.) are forced into src/.ai_outputs
# to keep the project root clean. This applies to ALL AI models (GPT, DeepSeek, Claude, etc.)
MCP_DATA_DIR=src/.ai_outputs
SCREENSHOT_DIR=src/.ai_outputs/screenshots
DOWNLOADS_DIR=src/.ai_outputs/downloads
SCRATCHPAD_DIR=src/.ai_outputs/ai_workspace
USER_DATA_DIR=src/.ai_outputs/user_data

# ─── Browser Settings ─────────────────────────────────────────
HEADLESS=false
DEFAULT_TIMEOUT_MS=10000
MAX_RETRIES=3

# Use system Chrome instead of bundled Chromium: "chrome" or "msedge"
BROWSER_CHANNEL=
# Force device scale factor (for Windows scaling issues): 1, 0.9, 0.8, 1.25
BROWSER_SCALE_FACTOR=

# Viewport size
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# ─── Behavior ─────────────────────────────────────────
STEALTH_MODE=true
TURBO_MODE=false
INTERACTION_LOCK=true
AUTO_CLEANUP=true
SESSION_SCREENSHOT_SUBDIRS=true

# ─── Session Persistence ──────────────────────────────
# When true, browser_open reuses existing sessions for same domain
SESSION_REUSE=true

# ─── Vision AI (Gemini Flash) ─────────────────────────
# Get a FREE API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
VISION_MODEL=gemini-2.0-flash
VISION_ENABLED=true
VISION_MAX_TOKENS=4096

# Free API automation intelligence (used by browser_fill_form fallback pipeline)
AI_SERVICE_ENABLED=true
AI_DOM_CONFIDENCE_THRESHOLD=0.82
AI_OCR_CONFIDENCE_THRESHOLD=0.74
AI_VISION_CONFIDENCE_THRESHOLD=0.72
AI_CACHE_TTL_MS=1800000
AI_TEMP_DIR=.mcp_data/temp
OCR_SPACE_API_KEY=helloworld
HUGGINGFACE_API_KEY=your_huggingface_token_here
HUGGINGFACE_VISION_MODEL=Salesforce/blip-image-captioning-large
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ─── Figma Integration ─────────────────────────────────
# Create token: Figma → Settings → Personal access tokens
FIGMA_API_TOKEN=your_figma_token_here
FIGMA_API_BASE_URL=https://api.figma.com/v1
